/*
    Function: AIC_fnc_jevJson

    Description:
        Writes an SQF value as JSON text for a Jev briefing. HashMaps become
        objects (keys written as strings), arrays become arrays, numbers,
        booleans and strings map directly, nil becomes null, anything else
        (sides, objects, groups) is written as its str text.

        Strings are made JSON-safe the simple way rather than escaped:
        double quotes become single quotes, backslashes become slashes and
        control characters are dropped. Briefing text is generated by the
        mod, so nothing is lost. Infinite / NaN numbers are written as 0.

    Parameters:
        0: ANYTHING - value to write

    Returns:
        STRING - JSON text

    Example:
        private _json = [createHashMapFromArray [["side", "OPFOR"], ["power", 212]]] call AIC_fnc_jevJson;
        // {"side":"OPFOR","power":212}
*/

params ["_value"];

if (isNil "_value") exitWith { "null" };

private _fnc_string = {
    params ["_text"];
    private _codes = ((toArray _text) select { _x >= 32 }) apply {
        switch (_x) do {
            case 34: { 39 };
            case 92: { 47 };
            default { _x };
        }
    };
    format ["""%1""", toString _codes]
};

switch (true) do {
    case (_value isEqualType ""): { [_value] call _fnc_string };
    case (_value isEqualType 0): { [str _value, "0"] select !(finite _value) };
    case (_value isEqualType true): { ["false", "true"] select _value };
    case (_value isEqualType []): {
        "[" + ((_value apply { [_x] call AIC_fnc_jevJson }) joinString ",") + "]"
    };
    case (_value isEqualType createHashMap): {
        private _parts = [];
        {
            private _key = [_x, str _x] select !(_x isEqualType "");
            _parts pushBack (([_key] call _fnc_string) + ":" + ([_y] call AIC_fnc_jevJson));
        } forEach _value;
        "{" + (_parts joinString ",") + "}"
    };
    default { [str _value] call _fnc_string };
}
